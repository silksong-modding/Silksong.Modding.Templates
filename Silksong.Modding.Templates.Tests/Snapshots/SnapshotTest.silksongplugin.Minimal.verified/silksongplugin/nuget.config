<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" protocolVersion="3" />
    <add
      key="silksong-modding"
      value="https://git.silksong-modding.org/api/packages/silksong-modding/nuget/index.json"
      protocolVersion="3"
    />
  </packageSources>
  <packageSourceMapping>
    <!-- silksong-modding publishes Silksong.* packages to its forge, but the prefix isn't reserved on nuget.org, so mods
         from other authors may publish Silksong.* packages there too -->
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Silksong.*" />
    </packageSource>
    <packageSource key="silksong-modding">
      <package pattern="Silksong.*" />
    </packageSource>
    <packageSource key="BepInEx">
      <package pattern="BepInEx.*" />
      <package pattern="UnityEngine.Modules" />
    </packageSource>
  </packageSourceMapping>
</configuration>
